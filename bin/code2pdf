#!/usr/bin/env bash

IGNORE_FILES=""
IGNORE_TYPES=""
IGNORE_FOLDERS=""
INCLUDE_TYPES=""

# Resolve the install directory (the parent of this script's real bin/ dir), following symlinks
resolve_install_dir() {
   local src="${BASH_SOURCE[0]}" dir
   while [ -L "$src" ]; do
       dir="$(cd -P "$(dirname "$src")" && pwd)"
       src="$(readlink "$src")"
       case "$src" in /*) ;; *) src="$dir/$src" ;; esac
   done
   cd -P "$(dirname "$src")/.." && pwd
}

# CODE2PDF_HOME overrides the location (used by the Homebrew formula)
get_install_dir() {
   INSTALL_DIR="${CODE2PDF_HOME:-$(resolve_install_dir)}"
   SCRIPTS_DIR="$INSTALL_DIR/scripts"
   CONFIG_DIR="$INSTALL_DIR/config"
   if [ ! -f "$SCRIPTS_DIR/print_all.sh" ]; then
       echo "Error: code2pdf scripts not found in $SCRIPTS_DIR" >&2
       exit 1
   fi

   # Use a private Python environment if there is one: venv/ (install.sh) or .venv/ (a checkout)
   for venv in "$INSTALL_DIR/venv" "$INSTALL_DIR/.venv"; do
       if [ -x "$venv/bin/python3" ]; then
           PATH="$venv/bin:$PATH"
           export PATH
           break
       fi
   done
}

# Help text
show_help() {
   echo "Usage: code2pdf [OPTIONS] <file or directory>"
   echo ""
   echo "Options:"
   echo "  -s, --single FILE         Convert a single file to PDF"
   echo "  -a, --all DIR             Convert all source files in directory"
   echo "  --ignore-types LIST       Comma-separated list of file extensions to ignore"
   echo "  --ignore-folders LIST     Comma-separated list of folders to skip"
   echo "  --ignore-files LIST       Comma-separated list of specific files to ignore"
   echo "  --include-types LIST      Only include these file types (overrides default whitelist)"
   echo "  --theme NAME              Colour theme: paper (default), mono (black & white), or any Pygments style"
   echo "  --list-themes             List all theme names"
   echo "  -q, --quiet               No progress output"
   echo "  --list-files              With -a: list the files that would be included, without converting"
   echo "  -h, --help                Show this help message"
   echo ""
   echo "Examples:"
   echo "  code2pdf -s myfile.py                                        # Convert single file"
   echo "  code2pdf -a src/                                             # Convert all files in directory"
   echo "  code2pdf -a --ignore-files package-lock.json src/            # Ignore specific files"
   echo "  code2pdf -a --ignore-types md,txt src/                       # Ignore file types"
   echo "  code2pdf -a --include-types js,ts src/                       # Only include JS/TS files"
   echo "  code2pdf -a --ignore-folders tests,docs src/                 # Skip folders"
   echo "  code2pdf -a --theme mono src/                                # Black & white for printing"
}

# Check dependencies
check_dependencies() {
   local missing=()

   # Check for command-line tools
   for cmd in python3; do
       if ! command -v $cmd &> /dev/null; then
           missing+=($cmd)
       fi
   done

   # Check for Python packages
   if command -v python3 &> /dev/null; then
       if ! python3 -c "import pygments, weasyprint" 2> /dev/null; then
           echo "Error: Python packages 'pygments' and 'weasyprint' are not available" >&2
           echo "  Homebrew:  brew reinstall readbysearch/tap/code2pdf" >&2
           echo "  Checkout:  python3 -m venv .venv && .venv/bin/pip install -r requirements.txt" >&2
           exit 1
       fi
   fi

   if [ ${#missing[@]} -ne 0 ]; then
       echo "Error: Missing required dependencies: ${missing[*]}" >&2
       echo "Please install them (e.g. brew install python3, or apt install python3-venv)" >&2
       exit 1
   fi
}

# Main logic
main() {
   # Store all arguments in an array to process them properly
   local args=()
   
   # First pass: extract options
   while [[ $# -gt 0 ]]; do
       case "$1" in
           --dev)
               # Kept for compatibility: the launcher now always uses the directory it is installed in
               shift
               ;;
           --ignore-files)
               IGNORE_FILES="$2"
               shift 2
               ;;
           --theme)
               # Read by scripts/dir_to_pdf.py and scripts/code_to_pdf.py
               export CODE2PDF_THEME="$2"
               shift 2
               ;;
           -q|--quiet)
               export CODE2PDF_QUIET=1
               shift
               ;;
           --list-files)
               LIST_FILES=1
               shift
               ;;
           --ignore-types)
               IGNORE_TYPES="$2"
               shift 2
               ;;
           --ignore-folders)
               IGNORE_FOLDERS="$2"
               shift 2
               ;;
           --include-types)
               INCLUDE_TYPES="$2"
               shift 2
               ;;
           *)
               # Store non-option arguments
               args+=("$1")
               shift
               ;;
       esac
   done

   # Restore positional parameters from stored arguments
   set -- "${args[@]}"
   
   case "$1" in
       -s|--single|-a|--all|--list-themes) ;;
       -h|--help) show_help; exit 0 ;;
       *) show_help; exit 1 ;;
   esac

   get_install_dir
   check_dependencies
   
   case "$1" in
       --list-themes)
           python3 "$SCRIPTS_DIR/theme.py" --list
           ;;
       -s|--single)
           shift
           "$SCRIPTS_DIR/print_single_file_to_pdf.sh" "$1" "$(pwd)"
           ;;
       -a|--all)
           shift
           # Build output, dependency caches and virtualenvs are skipped (hidden folders always are)
           DEFAULT_BLACKLIST='["node_modules", ".git", "dist", "out", "build", "target", "DerivedData", "Pods", "vendor", "__pycache__", "venv"]'
           DEFAULT_BLACKLIST_PATTERN='env*'
           DEFAULT_WHITELIST_EXTENSIONS='["c", "h", "cc", "cpp", "cxx", "hh", "hpp", "m", "mm", "swift", "go", "rs", "zig", "java", "kt", "kts", "scala", "groovy", "gradle", "cs", "fs", "py", "rb", "php", "pl", "lua", "r", "jl", "dart", "ex", "exs", "erl", "hs", "ml", "clj", "js", "mjs", "cjs", "jsx", "ts", "tsx", "vue", "svelte", "html", "css", "scss", "sql", "proto", "graphql", "sh", "bash", "zsh", "fish", "ps1", "md", "rst", "yaml", "yml", "toml"]'
           DEFAULT_WHITELIST_FILES='["README", "LICENSE", "Makefile", "launch.json"]'
           DEFAULT_INCLUDE_NO_EXTENSION='true'
           
           # Pass comma-separated parameters directly (like code2txt does)
           "$SCRIPTS_DIR/print_all.sh" "$1" "$CONFIG_DIR/vimrc" \
               "$DEFAULT_BLACKLIST" \
               "$DEFAULT_BLACKLIST_PATTERN" \
               "$DEFAULT_WHITELIST_EXTENSIONS" \
               "$DEFAULT_WHITELIST_FILES" \
               "$DEFAULT_INCLUDE_NO_EXTENSION" \
               "$IGNORE_FILES" \
               "$IGNORE_TYPES" \
               "$IGNORE_FOLDERS" \
               "$INCLUDE_TYPES" \
               ${LIST_FILES:+--list-files}
           ;;
       -h|--help)
           show_help
           ;;
       *)
           show_help
           exit 1
           ;;
   esac
}

main "$@"
