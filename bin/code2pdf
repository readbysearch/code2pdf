#!/usr/bin/env bash

IGNORE_FILES=""
IGNORE_TYPES=""
IGNORE_FOLDERS=""
INCLUDE_TYPES=""
OUTPUT=""
FILES_FROM=""
CHANGED=""
SUMMARY=""
SELECT_ARGS=()   # --include/--exclude, passed on to dir_to_pdf.py

# Resolve the install directory (the parent of this script's real bin/ dir), following symlinks
resolve_install_dir() {
   local src="${BASH_SOURCE[0]}" dir
   while [ -L "$src" ]; do
       dir="$(cd -P "$(dirname "$src")" && pwd)"
       src="$(readlink "$src")"
       case "$src" in /*) ;; *) src="$dir/$src" ;; esac
   done
   cd -P "$(dirname "$src")/.." && pwd
}

# CODE2PDF_HOME overrides the location (used by the Homebrew formula)
get_install_dir() {
   INSTALL_DIR="${CODE2PDF_HOME:-$(resolve_install_dir)}"
   SCRIPTS_DIR="$INSTALL_DIR/scripts"
   if [ ! -f "$SCRIPTS_DIR/print_all.sh" ]; then
       echo "Error: code2pdf scripts not found in $SCRIPTS_DIR" >&2
       exit 1
   fi

   # Use a private Python environment if there is one: venv/ (install.sh) or .venv/ (a checkout)
   for venv in "$INSTALL_DIR/venv" "$INSTALL_DIR/.venv"; do
       if [ -x "$venv/bin/python3" ]; then
           PATH="$venv/bin:$PATH"
           export PATH
           break
       fi
   done
}

# Help text
show_help() {
   cat <<'HELP'
Usage: code2pdf [OPTIONS] -s FILE
       code2pdf [OPTIONS] -a DIR

Options:
  -s, --single FILE         Convert one file to <name>.pdf in the current folder (FILE:START-END: part of it)
  -a, --all DIR             Convert the source files in DIR to DIR/merged.pdf, contents page first
  -o, --output PDF          Write the PDF here instead (a folder: the default name inside it;
                            missing folders are created)
  --summary TEXT            One sentence under the title saying what this PDF is (e.g. what was
                            asked for and what was left out); also the PDF's Subject
  --theme NAME              Colour theme: paper (default), mono (black & white), or any Pygments style
  --list-themes             List all theme names
  -q, --quiet               No progress output
  -j, --jobs N              Big directories render in parts; N parts at a time (default 3 with 16 GB RAM, ~1.3 GB each)
  -V, --version             Show the version, how it is installed, and library versions
  -h, --help                Show this help message

Choosing files for -a (every option can be repeated; LIST is comma-separated):
  --list-files              List the files that would be included, in order, without converting
  --include GLOB            Also include matching files of any type, even hidden ones or ones in
                            skipped folders; a folder (--include config) brings every file in it
  --exclude GLOB            Leave out matching files and folders (wins over everything else)
  --files-from FILE         Convert exactly the files listed in FILE, one per line, in that order
                            (- reads stdin; paths relative to DIR or absolute; DIR defaults to .).
                            path:START-END prints part of a file with its real line numbers
                            (also path:START-, path:LINE, path:10-40,90-120); +START-END prints
                            lines and marks them with a bar in the margin, -N marks lines
                            removed after line N: path:10-40,+12-14,-30 (path:1-,+12-14 for
                            the whole file with 12-14 marked)
  --changed REV             Print what changed since REV (a commit, tag or branch) in DIR's git
                            repository, compared with the files as they are now: each change
                            with its enclosing block (or a few lines around it, plus the def or
                            func line it is in), changed lines marked. Deleted and untracked files are left out, with a note.
                            With --list-files it prints that list, to edit and pass to --files-from
  --include-types LIST      Only include these extensions (replaces the default list)
  --ignore-types LIST       Skip these extensions
  --ignore-folders LIST     Skip folders with these names, at any depth
  --ignore-files LIST       Skip files with these names, at any depth

  By default -a includes common source code, Markdown, YAML and TOML, README, LICENSE, Makefile
  and files without an extension (not JSON, .txt or other data files: add them with --include);
  it skips hidden entries, binary files, node_modules, build,
  dist, out, target, DerivedData, Pods, vendor, __pycache__, venv and env*.
  Globs: * and ? match within a name (not a leading dot), ** matches any number of folders.
  Without "/" a glob matches names at any depth (*_test.go); with "/" it matches the path from
  DIR (src/legacy, docs/**/*.md). A glob that matches a folder covers everything in it. Skipped
  folders are entered only when a glob names them (.github, node_modules/foo). A glob that
  matches nothing prints a warning.

Examples:
  code2pdf -s myfile.py                                        # Convert one file
  code2pdf -a src/                                             # Convert a directory
  code2pdf -a . --exclude tests --exclude '*_test.*' --exclude '*.test.*' --list-files  # No tests; check first
  code2pdf -a . --exclude src/legacy --include '*.json' --include .github
  code2pdf -a . --include-types js,ts                          # Only JS/TS files
  git ls-files src | code2pdf --files-from - -o src.pdf        # Exactly these files
  printf 'app.py:120-180\nutil.py\n' | code2pdf --files-from -  # Part of app.py, all of util.py
  code2pdf --changed HEAD~1 -o change.pdf --summary "The fix for the login timeout"  # The last commit
  code2pdf -a src/ --theme mono                                # Black & white for printing
HELP
}

# Options that take a value: fail clearly instead of swallowing the next option
need_value() {
   if [ $# -lt 2 ] || [ -z "$2" ]; then
       echo "Error: $1 needs a value (see code2pdf --help)" >&2
       exit 1
   fi
}

# Check dependencies
check_dependencies() {
   local missing=()

   # Check for command-line tools
   for cmd in python3; do
       if ! command -v $cmd &> /dev/null; then
           missing+=($cmd)
       fi
   done

   # Check for Python packages
   if command -v python3 &> /dev/null; then
       if ! python3 -c "import pygments, weasyprint" 2> /dev/null; then
           echo "Error: Python packages 'pygments' and 'weasyprint' are not available" >&2
           echo "  Homebrew:  brew reinstall readbysearch/tap/code2pdf" >&2
           echo "  Checkout:  python3 -m venv .venv && .venv/bin/pip install -r requirements.txt" >&2
           exit 1
       fi
   fi

   if [ ${#missing[@]} -ne 0 ]; then
       echo "Error: Missing required dependencies: ${missing[*]}" >&2
       echo "Please install them (e.g. brew install python3, or apt install python3-venv)" >&2
       exit 1
   fi
}

# Main logic
main() {
   # Store all arguments in an array to process them properly
   local args=()
   
   # First pass: extract options
   while [[ $# -gt 0 ]]; do
       case "$1" in
           --dev)
               # Kept for compatibility: the launcher now always uses the directory it is installed in
               shift
               ;;
           --theme)
               # Read by scripts/dir_to_pdf.py and scripts/code_to_pdf.py
               need_value "$@"
               export CODE2PDF_THEME="$2"
               shift 2
               ;;
           -q|--quiet)
               export CODE2PDF_QUIET=1
               shift
               ;;
           -j|--jobs)
               need_value "$@"
               export CODE2PDF_JOBS="$2"
               shift 2
               ;;
           -o|--output)
               need_value "$@"
               OUTPUT="$2"
               shift 2
               ;;
           --list-files)
               LIST_FILES=1
               shift
               ;;
           # Repeating a list option adds to it
           --ignore-files)
               need_value "$@"
               IGNORE_FILES="${IGNORE_FILES:+$IGNORE_FILES,}$2"
               shift 2
               ;;
           --ignore-types)
               need_value "$@"
               IGNORE_TYPES="${IGNORE_TYPES:+$IGNORE_TYPES,}$2"
               shift 2
               ;;
           --ignore-folders)
               need_value "$@"
               IGNORE_FOLDERS="${IGNORE_FOLDERS:+$IGNORE_FOLDERS,}$2"
               shift 2
               ;;
           --include-types)
               need_value "$@"
               INCLUDE_TYPES="${INCLUDE_TYPES:+$INCLUDE_TYPES,}$2"
               shift 2
               ;;
           --include|--exclude)
               need_value "$@"
               SELECT_ARGS+=("$1" "$2")
               shift 2
               ;;
           --files-from)
               need_value "$@"
               FILES_FROM="$2"
               shift 2
               ;;
           --changed)
               need_value "$@"
               CHANGED="$2"
               shift 2
               ;;
           --summary)
               need_value "$@"
               SUMMARY="$2"
               shift 2
               ;;
           -s|--single|-a|--all|--list-themes|-h|--help|-V|--version)
               args+=("$1")
               shift
               ;;
           -?*)
               echo "Error: unknown option $1 (see code2pdf --help)" >&2
               exit 1
               ;;
           *)
               # Store non-option arguments
               args+=("$1")
               shift
               ;;
       esac
   done

   # Restore positional parameters from stored arguments
   set -- "${args[@]}"
   # --files-from and --changed choose the files themselves; DIR defaults to the current folder
   if [ -n "$FILES_FROM$CHANGED" ] && [ $# -eq 0 ]; then
       set -- -a .
   fi
   case "$1" in
       -s|--single|-a|--all)
           if [ $# -gt 2 ]; then
               echo "Error: $1 takes one path; unexpected: ${*:3} (see code2pdf --help)" >&2
               exit 1
           fi ;;
   esac
   if [ -n "$FILES_FROM$CHANGED$LIST_FILES${SELECT_ARGS[*]}" ] && [[ "$1" != -a && "$1" != --all ]]; then
       echo "Error: --files-from, --changed, --include, --exclude and --list-files work with -a DIR" >&2
       exit 1
   fi
   
   case "$1" in
       -s|--single|-a|--all|--list-themes) ;;
       -h|--help) show_help; exit 0 ;;
       -V|--version)
           # Before the dependency check, so it also works (and helps debug) a broken install
           get_install_dir
           if command -v python3 &> /dev/null; then
               python3 "$SCRIPTS_DIR/version.py" code2pdf
           else
               echo "code2pdf (version unknown: python3 not found), $INSTALL_DIR"
           fi
           exit 0 ;;
       *) show_help; exit 1 ;;
   esac

   get_install_dir
   check_dependencies
   
   case "$1" in
       --list-themes)
           python3 "$SCRIPTS_DIR/theme.py" --list
           ;;
       -s|--single)
           shift
           single_args=("$1" "$(pwd)" "$OUTPUT")
           [ -n "$SUMMARY" ] && single_args+=(--summary "$SUMMARY")
           exec "$SCRIPTS_DIR/print_single_file_to_pdf.sh" "${single_args[@]}"
           ;;
       -a|--all)
           shift
           # Build output, dependency caches and virtualenvs are skipped, like hidden entries (unless --include names them)
           DEFAULT_BLACKLIST='["node_modules", ".git", "dist", "out", "build", "target", "DerivedData", "Pods", "vendor", "__pycache__", "venv"]'
           DEFAULT_BLACKLIST_PATTERN='env*'
           DEFAULT_WHITELIST_EXTENSIONS='["c", "h", "cc", "cpp", "cxx", "hh", "hpp", "m", "mm", "swift", "go", "rs", "zig", "java", "kt", "kts", "scala", "groovy", "gradle", "cs", "fs", "py", "rb", "php", "pl", "lua", "r", "jl", "dart", "ex", "exs", "erl", "hs", "ml", "clj", "js", "mjs", "cjs", "jsx", "ts", "tsx", "vue", "svelte", "html", "css", "scss", "sql", "proto", "graphql", "sh", "bash", "zsh", "fish", "ps1", "md", "rst", "yaml", "yml", "toml"]'
           DEFAULT_WHITELIST_FILES='["README", "LICENSE", "Makefile", "launch.json"]'
           DEFAULT_INCLUDE_NO_EXTENSION='true'
           [ -n "$LIST_FILES" ] && SELECT_ARGS+=(--list-files)
           [ -n "$OUTPUT" ] && SELECT_ARGS+=(--output "$OUTPUT")
           [ -n "$FILES_FROM" ] && SELECT_ARGS+=(--files-from "$FILES_FROM")
           [ -n "$CHANGED" ] && SELECT_ARGS+=(--changed "$CHANGED")
           [ -n "$SUMMARY" ] && SELECT_ARGS+=(--summary "$SUMMARY")
           
           # exec: a signal sent to code2pdf (e.g. a command timeout) reaches the renderer
           exec "$SCRIPTS_DIR/print_all.sh" "$1" \
               "$DEFAULT_BLACKLIST" \
               "$DEFAULT_BLACKLIST_PATTERN" \
               "$DEFAULT_WHITELIST_EXTENSIONS" \
               "$DEFAULT_WHITELIST_FILES" \
               "$DEFAULT_INCLUDE_NO_EXTENSION" \
               "$IGNORE_FILES" \
               "$IGNORE_TYPES" \
               "$IGNORE_FOLDERS" \
               "$INCLUDE_TYPES" \
               "${SELECT_ARGS[@]}"
           ;;
   esac  # -h and unknown options were handled by the first case
}

main "$@"
